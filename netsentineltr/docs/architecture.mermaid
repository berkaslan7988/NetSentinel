flowchart TB
    subgraph CAP["1 · Capture Layer"]
        SNIFF["Scapy AsyncSniffer<br/>(yakalama thread'i — hafif)"]
    end

    subgraph PROC["Worker Thread'ler"]
        FLOW["2 · FlowManager<br/>5-tuple bidirectional<br/>active/idle/FIN-RST timeout"]
        FEAT["3 · FeatureExtractor<br/>CIC-IDS2017 uyumlu 78 özellik"]
        DET["4 · DetectionEngine<br/>RandomForest + IsolationForest + Autoencoder<br/>scaler (eğitimle aynı)"]
        ALERT["5 · AlertEngine<br/>RF-ağırlıklı 0-100 risk<br/>dedup / aggregation / IP profili"]
    end

    subgraph OUT["Çıktı"]
        DB[("6 · SQLite<br/>flows / alerts / stats<br/>batch insert")]
        UI["7 · Dashboard<br/>PySide6 + pyqtgraph<br/>QTimer 250ms batch"]
        REP["9 · Raporlama<br/>CSV / PDF / metrikler"]
    end

    SNIFF -->|"ham paket → queue"| FLOW
    FLOW -->|"kapanan akış"| FEAT
    FEAT -->|"feature vektörü"| DET
    DET -->|"DetectionResult"| ALERT
    ALERT -->|"Alert"| DB
    ALERT --> UI
    DET --> DB
    DB --> REP

    REPLAY["Replay kaynağı<br/>CIC-IDS2017 CSV / DB"] -.->|"demo modu"| DET

    classDef cap fill:#0f140f,stroke:#33ff66,color:#7dffa0
    classDef proc fill:#0f140f,stroke:#00ffcc,color:#33ff66
    classDef out fill:#0f140f,stroke:#1f9a3f,color:#33ff66
    class SNIFF cap
    class FLOW,FEAT,DET,ALERT proc
    class DB,UI,REP,REPLAY out
